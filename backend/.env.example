# Portal FV Backend .env.example — copy to .env and set secrets (>=32 chars for JWT)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development
DATABASE_URL=sqlite:///instance/portal.db
JWT_SECRET_KEY=43a26e541b4601e9ddbeeef4b654ac465b51d3b471ecd12a83e6c1c458b300e4
SECRET_KEY=43a26e541b4601e9ddbeeef4b654ac465b51d3b471ecd12a83e6c1c458b300e4
PORT=5000
# NOTE: JWT_SECRET_KEY must be >=32 chars (RFC 7518 §3.2). Short keys trigger InsecureKeyLengthWarning and are rejected in production.

# Mail
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=noreply@example.com

# Bulk
BULK_EMAIL_ENABLED=true

# Hidden invite tokens for registration (share manually, not public)
# Admin shares links: /r/a/<ALUMNO_INVITE_TOKEN> for students, /r/p/<PROFESOR_INVITE_TOKEN> for teachers
# No public /signup — these routes are Disallow in robots.txt and noindex
ALUMNO_INVITE_TOKEN=ca2d949f-5cd2-4785-918e-205d6566f4e7
PROFESOR_INVITE_TOKEN=ef4a3a25-0214-4581-97dc-5104bb06c748
# Example: Alumno link = https://tu-dominio/r/a/ca2d949f-5cd2-4785-918e-205d6566f4e7
# Example: Profesor link = https://tu-dominio/r/p/ef4a3a25-0214-4581-97dc-5104bb06c748

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3050
REDIS_URL=memory://
FRONTEND_URL=http://localhost:5173
